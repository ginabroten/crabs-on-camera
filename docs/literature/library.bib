@mastersthesis{broten_crabs_2026,
	title = {Crabs on camera: {Improving} the monitoring of the brown crab (\textit{{Cancer} pagurus}) with machine learning and {Baited} {Remote} {Underwater} {Video} ({BRUV})},
	url = {https://hdl.handle.net/11250/5537346},
	abstract = {The Norwegian brown crab (Cancer pagurus) supports a valuable small-scale inshore fishery of ecological, economic and social importance to coastal communities. Despite this, data limitations persist and constrain stock assessments. Baited Remote Underwater Video (BRUV) are increasingly used in Norwegian coastal monitoring programs due to their non-invasive and cost-effective nature. Substantial BRUV footage exists from these monitoring programs, representing an underutilized resource for brown crab assessments. However, the resource-demanding manual annotation process remains a major bottleneck limiting how much of the data can be translated into assessment-ready data.

An object detection model (YOLOv8) was developed and applied to identify and quantify brown crabs in BRUV footage collected from areas with high commercial crab catches along the Norwegian coast (62–68°N). The model achieved good performances, but with a conservative prediction behavior, indicating that the model was more likely to miss true crab detections than produce false ones. Rather than relying on conventional confidence thresholds for retaining predictions, which risks discarding correct predictions, an ecology-informed filtering pipeline was developed, based on known crab and object detection model behavior, representing a practical advance over standard confidence threshold approaches. Maximum number of crabs visible within a single frame per BRUV station (MaxN) became more accurate after the filtering pipeline. The relationship between MaxN and nearby pot catch was significant in all model formulations, supporting its utility as a relative abundance index. Object detection model performance was, however, domain-specific, and operational deployment beyond the current survey conditions would require retraining on representative data.

Together, the results suggest that combining existing BRUV data with object detection offers a low-cost pathway to improving data coverage for the data-limited brown crab stock, though biological domain expertise must remain central to how these tools are developed, not only limited to their application.},
	school = {University of Bergen},
	author = {Brøten, Gina},
	year = {2026},
	file = {PDF:C\:\\Users\\a46986\\Zotero\\storage\\YJ7YSDES\\Brøten - 2026 - Crabs on camera Improving the monitoring of the brown crab (Cancer pagurus) with machine lea.pdf:application/pdf},
}

